# ---- Supplied by you (the owner) ----
GEMINI_API_KEY=            # Google AI Studio API key; all in-app AI uses Gemini Flash
GNEWS_API_KEY=             # gnews.io free-plan key for news API queries
DATABASE_URL=              # Neon pooled Postgres connection string (or supply NEON_API_KEY instead)
NEON_API_KEY=              # Optional: Neon API key so the build can create the project itself
TELEGRAM_BOT_TOKEN=        # Bot token from @BotFather
RESEND_API_KEY=            # Resend API key with full access (needed to create the webhook)
OWNER_EMAIL=               # Email address of your Resend account; the only real inbox that receives test sends
GITHUB_TOKEN=              # Fine-grained GitHub token to create and push the public repo
VERCEL_TOKEN=              # Vercel account token to create, configure and deploy the project

# ---- Generated by the build ----
CRON_SECRET=               # Bearer secret that Vercel Cron sends to /api/cron/*
TELEGRAM_WEBHOOK_SECRET=   # secret_token checked on every Telegram webhook update
TELEGRAM_CHAT_ID=          # The only chat allowed to review/approve (read from getUpdates after /start)
TELEGRAM_BOT_USERNAME=     # Bot username (from getMe), used for the dashboard's "Open Telegram" link
UNSUBSCRIBE_SIGNING_SECRET= # HMAC key for per-recipient unsubscribe tokens
ADMIN_PASSWORD=            # Unused since the dashboard was opened to everyone (kept for compatibility)
RESEND_WEBHOOK_SECRET=     # Svix signing secret of the Resend webhook
APP_BASE_URL=              # Production URL, e.g. https://the-dispatch.vercel.app
EMAIL_MODE=test            # dry_run | test | live  (live also needs LIVE_SEND_CONFIRMED=true)
LIVE_SEND_CONFIRMED=       # Must be "true" together with EMAIL_MODE=live to email real subscribers
GEMINI_MODEL=              # Newest stable Gemini Flash model, e.g. gemini-2.5-flash
TZ_NAME=Asia/Kolkata       # Timezone used for all scheduling logic
