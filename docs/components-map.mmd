flowchart LR
  subgraph S0["0 · Build & schedule"]
    direction TB
    GH["<b>GitHub</b><br/><i>source code<br/>public repo</i>"]
    V["<b>Vercel</b><br/><i>Next.js app · API routes<br/>· dashboard</i>"]
    CRON["<b>Vercel Cron</b> (IST)<br/><i>Mon–Wed 7 AM ingest<br/>Wed 3 PM draft<br/>Wed 10 PM reminder<br/>Thu 8 AM send<br/>Thu 6 PM report</i>"]
    GH -- "deploys" --> V -- "schedules" --> CRON
  end

  subgraph S1["1 · Collect · Mon–Wed"]
    direction TB
    SRC["<b>RSS + Google News<br/>+ GNews API</b><br/><i>25 live Indian startup<br/>& tech sources</i>"]
    N1[("<b>Neon Postgres</b><br/><i>store articles<br/>URL-hash + pg_trgm dedup<br/>exclude last 4 issues</i>")]
    SRC -- "fetch · normalise" --> N1
  end

  subgraph S2["2 · Select & write · Wed 3 PM"]
    direction TB
    GEM["<b>Gemini Flash</b><br/><i>tag topics<br/>pick 8–10 stories, 3+ topics<br/>2–3 lines in her voice</i>"]
    N2[("<b>Neon</b><br/><i>draft · reserves<br/>rationale · voice guide</i>")]
    GEM -- "validated in code" --> N2
  end

  subgraph S3["3 · Shreya reviews · Telegram only"]
    direction TB
    TG["<b>Telegram bot</b><br/><i>per story: keep · edit<br/>swap · reject<br/>confirm final draft<br/>Wed 10 PM reminder</i>"]
    N3[("<b>Neon</b><br/><i>approval status, time,<br/>channel · edits revoke it</i>")]
    TG -- "secret + her chat only" --> N3
  end

  subgraph S4["4 · Deliver · Thu 8 AM"]
    direction TB
    RS["<b>Resend</b><br/><i>gated batch send<br/>idempotency keys<br/>one-click unsubscribe</i>"]
    SUB["<b>Subscribers</b><br/><i>active only<br/>(test mode: test inboxes)</i>"]
    WH["<b>Resend webhooks</b><br/><i>delivered · bounced · spam<br/>Svix-signed</i>"]
    N4[("<b>Neon</b><br/><i>suppress bounces, spam,<br/>unsubscribes · stats</i>")]
    RS -- "sends" --> SUB -- "events" --> WH -- "update" --> N4
  end

  subgraph S5["5 · Watch"]
    direction TB
    DASH["<b>Dashboard</b><br/><i>view only: overview · draft<br/>articles · voice · subscribers</i>"]
    BACK["<b>Send to Telegram</b><br/><i>any article → Shreya:<br/>add to draft or<br/>save for next issue</i>"]
    DASH --> BACK
  end

  S0 -- "cron triggers ingest" --> S1
  S1 -- "candidates + voice guide<br/>+ past 4 headlines" --> S2
  S2 -- "draft cards<br/>+ buttons" --> S3
  S3 -- "atomic claim:<br/>approved → sending" --> S4
  S4 -- "reads everything<br/>in Neon" --> S5
