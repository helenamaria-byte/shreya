flowchart TB
  GH["GitHub<br/><i>source code repo</i>"] -- "deploys (vercel --prod)" --> V["Vercel<br/><i>Next.js app, API routes, dashboard</i>"]
  V -- "schedules" --> CRON["Vercel Cron<br/><i>Mon–Wed ingest · Wed 3 PM draft · Wed 10 PM reminder · Thu 8 AM send · Thu 6 PM report</i>"]
  CRON -- "triggers /api/cron/ingest" --> SRC["RSS feeds + Google News RSS + GNews API<br/><i>live Indian startup & tech news</i>"]
  SRC -- "fetch, normalise URLs, strip HTML" --> NEON1[("Neon Postgres<br/><i>store articles · dedup by URL hash + pg_trgm title similarity · past-4-issues check</i>")]
  NEON1 -- "candidates + voice guide + past headlines" --> GEM["Gemini Flash<br/><i>tag topics · select 8–10 stories · write 2–3 line commentary · learn voice from her samples</i>"]
  GEM -- "validated draft (code checks counts, topics, numbers)" --> NEON2[("Neon<br/><i>issue draft: stories, reserves, rationale</i>")]
  NEON2 -- "draft cards + buttons (Wed 3 PM)" --> TG["Telegram bot<br/><i>Shreya, per story: keep · edit · swap · reject; then confirms the final draft</i>"]
  TG -- "webhook updates (secret + chat ID checked)" --> NEON3[("Neon<br/><i>approval status, time, channel · edits revoke approval</i>")]
  NEON3 -- "atomic claim: approved → sending (Thu 8 AM)" --> RS["Resend<br/><i>batch send · idempotency keys · List-Unsubscribe headers</i>"]
  RS -- "delivers newsletter" --> SUB["Subscribers<br/><i>active only; test mode = test addresses</i>"]
  SUB -- "delivered / bounced / complained" --> RWH["Resend webhooks<br/><i>Svix-signed: delivered · hard/soft bounce · spam complaint</i>"]
  RWH -- "suppress bounces & complaints" --> NEON4[("Neon<br/><i>subscriber status · deliveries · unsubscribes</i>")]
  SUB -- "one-click unsubscribe (HMAC link)" --> NEON4
  NEON4 -- "Thu 6 PM delivery report" --> TG
  NEON4 -- "read-only pages + admin actions" --> DASH["Dashboard (newspaper)<br/><i>front page · draft · articles · voice · subscribers · logs · how it works</i>"]
